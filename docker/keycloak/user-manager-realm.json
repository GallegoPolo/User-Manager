{
  "realm": "user-manager",
  "displayName": "User-Manager",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@user-manager.local",
    "fromDisplayName": "User-Manager",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "authenticatorConfig": [
    {
      "alias": "vinculo - revisar perfil",
      "config": { "update.profile.on.first.login": "missing" }
    },
    {
      "alias": "vinculo - criar pessoa",
      "config": { "require.password.update.after.registration": "false" }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "first broker login por reautenticacao",
      "description": "Primeiro login por provedor externo; conta existente só é vinculada com reautenticação, nunca por e-mail",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "idp-review-profile", "authenticatorConfig": "vinculo - revisar perfil", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "flowAlias": "vinculo - criar ou vincular", "requirement": "REQUIRED", "priority": 20, "authenticatorFlow": true, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "vinculo - criar ou vincular",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "idp-create-user-if-unique", "authenticatorConfig": "vinculo - criar pessoa", "requirement": "ALTERNATIVE", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "flowAlias": "vinculo - conta existente", "requirement": "ALTERNATIVE", "priority": 20, "authenticatorFlow": true, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "vinculo - conta existente",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "idp-confirm-link", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "idp-username-password-form", "requirement": "REQUIRED", "priority": 20, "authenticatorFlow": false, "userSetupAllowed": false },
        { "flowAlias": "vinculo - 2FA condicional", "requirement": "CONDITIONAL", "priority": 30, "authenticatorFlow": true, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "vinculo - 2FA condicional",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-configured", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "requirement": "ALTERNATIVE", "priority": 20, "authenticatorFlow": false, "userSetupAllowed": false }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": "${GITHUB_ENABLED:false}",
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login por reautenticacao",
      "config": {
        "clientId": "${GITHUB_CLIENT_ID:nao-configurado}",
        "clientSecret": "${GITHUB_CLIENT_SECRET:nao-configurado}",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": "${GOOGLE_ENABLED:false}",
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login por reautenticacao",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:nao-configurado}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:nao-configurado}",
        "syncMode": "IMPORT"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Lê a lista de usuários e a auditoria"
      },
      {
        "name": "operator",
        "description": "Lê e altera usuários; lê a auditoria"
      }
    ]
  },
  "clients": [
    {
      "clientId": "user-manager-bff",
      "name": "User-Manager BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "user-manager-bff-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/signin-oidc"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "realm roles (claim roles)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "usermodel.realmRoleMapping.rolePrefix": "",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience user-manager-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "user-manager-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience audit-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "audit-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ana",
      "email": "ana@user-manager.local",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Souza",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "ana123", "temporary": false }
      ],
      "realmRoles": ["default-roles-user-manager"]
    },
    {
      "username": "vera",
      "email": "vera@user-manager.local",
      "emailVerified": true,
      "firstName": "Vera",
      "lastName": "Lima",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "vera123", "temporary": false }
      ],
      "realmRoles": ["default-roles-user-manager", "viewer"]
    },
    {
      "username": "otto",
      "email": "otto@user-manager.local",
      "emailVerified": true,
      "firstName": "Otto",
      "lastName": "Reis",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "otto123", "temporary": false }
      ],
      "realmRoles": ["default-roles-user-manager", "operator"]
    }
  ]
}
