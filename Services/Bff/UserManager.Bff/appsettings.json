{
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Oidc": {
    "Authority": "http://localhost:8080/realms/user-manager",
    "ClientId": "user-manager-bff"
  },
  "ReverseProxy": {
    "Routes": {
      "me": {
        "ClusterId": "usermanager",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/me/{**rest}" }
      },
      "users": {
        "ClusterId": "usermanager",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/users/{**rest}" }
      },
      "audit": {
        "ClusterId": "audit",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/audit/{**rest}" }
      }
    },
    "Clusters": {
      "usermanager": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5255" }
        }
      },
      "audit": {
        "Destinations": {
          "primary": { "Address": "http://localhost:7175" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
